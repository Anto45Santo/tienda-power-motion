<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.shape.*?>

<!-- Marco de la tienda: barra superior fija + zona central donde se cargan las demás pantallas -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vista.frmTienda"
            prefWidth="1200" prefHeight="688">
    <stylesheets>
        <URL value="@estilos.css"/>
        <URL value="@tienda.css"/>
    </stylesheets>

    <top>
        <HBox styleClass="barra" spacing="12" alignment="CENTER_LEFT">
            <HBox spacing="8" alignment="CENTER_LEFT" onMouseClicked="#irCatalogo" styleClass="logo">
                <ImageView fitHeight="26" preserveRatio="true"><Image url="@../img/logo_pm.png"/></ImageView>
                <ImageView fitHeight="28" preserveRatio="true"><Image url="@../img/logo_texto.png"/></ImageView>
            </HBox>
            <MenuButton fx:id="btnCategorias" text="Categorías" styleClass="btn-barra">
                <graphic><Group><SVGPath styleClass="ico,ico-blanco" scaleX="0.75" scaleY="0.75" content="M4 7h16M4 12h16M4 17h16"/></Group></graphic>
            </MenuButton>
            <HBox styleClass="buscador" HBox.hgrow="ALWAYS" maxWidth="520">
                <TextField fx:id="txtBuscar" promptText="Buscar productos, marcas y más…" HBox.hgrow="ALWAYS" onAction="#buscar"/>
                <Button fx:id="btnBuscar" onAction="#buscar" styleClass="btn-buscar">
                    <graphic><Group><SVGPath styleClass="ico,ico-blanco" scaleX="0.75" scaleY="0.75" content="M4 10.8a6.8 6.8 0 1 0 13.6 0a6.8 6.8 0 1 0 -13.6 0 M15.6 15.6 20 20"/></Group></graphic>
                </Button>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <StackPane>
                <Button fx:id="btnMeGusta" onAction="#irMeGusta" styleClass="btn-barra">
                    <graphic><Group><SVGPath styleClass="ico,ico-blanco" scaleX="0.833" scaleY="0.833" content="M12 20s-7.5-4.6-7.5-10.2A4.2 4.2 0 0 1 12 7.3a4.2 4.2 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/></Group></graphic>
                    <tooltip><Tooltip text="Me gusta"/></tooltip>
                </Button>
                <Label fx:id="lblMeGusta" styleClass="contador" StackPane.alignment="TOP_RIGHT" mouseTransparent="true"/>
            </StackPane>
            <StackPane>
                <Button fx:id="btnCarrito" onAction="#irCarrito" styleClass="btn-barra">
                    <graphic><Group><SVGPath styleClass="ico,ico-blanco" scaleX="0.833" scaleY="0.833" content="M5 8h14l1 12H4L5 8Z M9 9V6a3 3 0 0 1 6 0v3"/></Group></graphic>
                    <tooltip><Tooltip text="Carrito"/></tooltip>
                </Button>
                <Label fx:id="lblCarrito" styleClass="contador" StackPane.alignment="TOP_RIGHT" mouseTransparent="true"/>
            </StackPane>
            <MenuButton fx:id="btnUsuario" styleClass="btn-barra, btn-usuario">
                <graphic>
                    <StackPane>
                        <Circle radius="12" styleClass="avatar"/>
                        <Label fx:id="lblInicial" styleClass="avatar-texto" style="-fx-font-size: 10px;"/>
                    </StackPane>
                </graphic>
                <items>
                    <CustomMenuItem hideOnClick="false">
                        <content>
                            <HBox styleClass="cabecera-menu">
                                <StackPane>
                                    <Circle radius="16" styleClass="avatar"/>
                                    <Label fx:id="lblIniciales" styleClass="avatar-texto" style="-fx-font-size: 13px;"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label fx:id="lblNombreMenu" styleClass="negrita"/>
                                    <Label fx:id="lblCorreoMenu" styleClass="gris"/>
                                </VBox>
                            </HBox>
                        </content>
                    </CustomMenuItem>
                    <SeparatorMenuItem/>
                    <MenuItem text="Mi perfil" onAction="#irPerfil"><graphic><Group><SVGPath styleClass="ico,ico-oscuro" scaleX="0.75" scaleY="0.75" content="M8.4 8a3.6 3.6 0 1 0 7.2 0a3.6 3.6 0 1 0 -7.2 0 M4.8 20c.6-4 3-6 7.2-6s6.6 2 7.2 6"/></Group></graphic></MenuItem>
                    <MenuItem text="Mis compras" onAction="#irCompras"><graphic><Group><SVGPath styleClass="ico,ico-oscuro" scaleX="0.75" scaleY="0.75" content="M3 7l9-4 9 4v10l-9 4-9-4z M3 7l9 4 9-4M12 11v10"/></Group></graphic></MenuItem>
                    <MenuItem text="Me gusta" onAction="#irMeGusta"><graphic><Group><SVGPath styleClass="ico,ico-oscuro" scaleX="0.75" scaleY="0.75" content="M12 20s-7.5-4.6-7.5-10.2A4.2 4.2 0 0 1 12 7.3a4.2 4.2 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/></Group></graphic></MenuItem>
                    <MenuItem text="Carrito" onAction="#irCarrito"><graphic><Group><SVGPath styleClass="ico,ico-oscuro" scaleX="0.75" scaleY="0.75" content="M5 8h14l1 12H4L5 8Z M9 9V6a3 3 0 0 1 6 0v3"/></Group></graphic></MenuItem>
                    <SeparatorMenuItem/>
                    <MenuItem text="Cerrar sesión" onAction="#cerrarSesion" styleClass="menu-salir"><graphic><Group><SVGPath styleClass="ico,ico-rojo" scaleX="0.75" scaleY="0.75" content="M10 4H5v16h5M15 8l4 4-4 4M19 12H9"/></Group></graphic></MenuItem>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contenido">
            <Label fx:id="lblAviso" styleClass="aviso" StackPane.alignment="BOTTOM_CENTER" visible="false" mouseTransparent="true">
                <StackPane.margin><Insets bottom="24"/></StackPane.margin>
            </Label>
        </StackPane>
    </center>
</BorderPane>
