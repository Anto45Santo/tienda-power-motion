<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.shape.*?>

<!-- Marco del administrador: menú lateral + cabecera + zona central -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vista.frmAdmin"
            prefWidth="1200" prefHeight="688">
    <stylesheets>
        <URL value="@estilos.css"/>
        <URL value="@admin.css"/>
    </stylesheets>
    <left>
        <VBox styleClass="lateral">
            <ImageView fitWidth="140" preserveRatio="true">
                <Image url="@../img/logo.png"/>
                <VBox.margin><Insets left="10"/></VBox.margin>
            </ImageView>
            <Label text="ADMINISTRADOR" styleClass="rol"/>
            <ToggleButton fx:id="navPedidos" text="Pedidos" styleClass="nav" onAction="#irPedidos">
                <graphic><Group><SVGPath styleClass="ico,ico-blanco" scaleX="0.833" scaleY="0.833" content="M3 7l9-4 9 4v10l-9 4-9-4z M3 7l9 4 9-4M12 11v10"/></Group></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navProductos" text="Productos" styleClass="nav" onAction="#irProductos">
                <graphic><Group><SVGPath styleClass="ico,ico-blanco" scaleX="0.833" scaleY="0.833" content="M3 12V4h8l10 10-8 8z M6.2 8.5a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0 -2.6 0"/></Group></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navImagenes" text="Imágenes" styleClass="nav" onAction="#irImagenes">
                <graphic><Group><SVGPath styleClass="ico,ico-blanco" scaleX="0.833" scaleY="0.833" content="M5 4H19a2 2 0 0 1 2 2V18a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2V6a2 2 0 0 1 2 -2z M7 10a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M3 18l6-6 5 5 3-3 3 3"/></Group></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navResenas" text="Reseñas" styleClass="nav" onAction="#irResenas">
                <graphic><Group><SVGPath styleClass="ico,ico-blanco" scaleX="0.833" scaleY="0.833" content="M4 5h16v11H9l-5 4z M8 10h8M8 13h5"/></Group></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navUsuarios" text="Usuarios" styleClass="nav" onAction="#irUsuarios">
                <graphic><Group><SVGPath styleClass="ico,ico-blanco" scaleX="0.833" scaleY="0.833" content="M5.8 8a3.2 3.2 0 1 0 6.4 0a3.2 3.2 0 1 0 -6.4 0 M3 20c.5-3.5 2.6-5.5 6-5.5s5.5 2 6 5.5 M14.5 9a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0 M16.5 14.5c2.5 0 4 1.7 4.5 4.5"/></Group></graphic>
            </ToggleButton>
            <Region VBox.vgrow="ALWAYS"/>
            <Region styleClass="separador" style="-fx-background-color: rgba(255,255,255,0.12);"/>
            <HBox fx:id="boxUsuario" styleClass="usuario" spacing="10" alignment="CENTER_LEFT">
                <padding><Insets top="12" left="8" bottom="6"/></padding>
                <StackPane>
                    <Circle radius="16" styleClass="avatar"/>
                    <Label fx:id="lblIniciales" styleClass="avatar-texto" style="-fx-font-size: 13px;"/>
                </StackPane>
                <VBox>
                    <Label fx:id="lblAdmin" styleClass="negrita"/>
                    <Label text="Administrador" styleClass="gris"/>
                </VBox>
            </HBox>
            <Hyperlink fx:id="lnkSalir" text="Cerrar sesión" onAction="#cerrarSesion" styleClass="salir">
                <graphic><Group><SVGPath styleClass="ico,ico-blanco" scaleX="0.667" scaleY="0.667" content="M10 4H5v16h5M15 8l4 4-4 4M19 12H9"/></Group></graphic>
                <VBox.margin><Insets left="8"/></VBox.margin>
            </Hyperlink>
        </VBox>
    </left>
    <center>
        <VBox>
            <HBox styleClass="cabecera-admin">
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="lblTitulo" styleClass="titulo"/>
                    <Label fx:id="lblSubtitulo" styleClass="gris"/>
                </VBox>
            </HBox>
            <StackPane fx:id="contenido" VBox.vgrow="ALWAYS">
                <Label fx:id="lblAviso" styleClass="aviso" StackPane.alignment="BOTTOM_CENTER" visible="false" mouseTransparent="true">
                    <StackPane.margin><Insets bottom="24"/></StackPane.margin>
                </Label>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
