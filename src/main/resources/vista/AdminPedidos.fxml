<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.shape.*?>

<!-- 13 · Admin – Pedidos -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vista.frmAdminPedidos" styleClass="zona-admin">
    <stylesheets>
        <URL value="@estilos.css"/>
        <URL value="@admin.css"/>
    </stylesheets>
    <!-- Indicadores (los números los pone frmAdminPedidos) -->
    <HBox fx:id="boxKpis" spacing="12">
        <HBox styleClass="kpi" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <StackPane styleClass="icono-kpi"><Group><SVGPath styleClass="ico,ico-azul" scaleX="0.833" scaleY="0.833" content="M12 3v18M16.5 7.5c-.6-1.6-2.4-2.5-4.5-2.5-2.5 0-4.5 1.3-4.5 3.4 0 4.6 9.2 2.3 9.2 7.1 0 2.2-2 3.5-4.7 3.5-2.4 0-4.3-1-4.9-2.9"/></Group></StackPane>
            <VBox spacing="2">
                <Label text="Ventas aprobadas" styleClass="gris"/>
                <Label fx:id="lblVentas" styleClass="valor"/>
            </VBox>
        </HBox>
        <HBox styleClass="kpi" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <StackPane styleClass="icono-kpi"><Group><SVGPath styleClass="ico,ico-azul" scaleX="0.833" scaleY="0.833" content="M3 7l9-4 9 4v10l-9 4-9-4z M3 7l9 4 9-4M12 11v10"/></Group></StackPane>
            <VBox spacing="2">
                <Label text="Pedidos hoy" styleClass="gris"/>
                <Label fx:id="lblHoy" styleClass="valor"/>
            </VBox>
        </HBox>
        <HBox styleClass="kpi" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <StackPane styleClass="icono-kpi"><Group><SVGPath styleClass="ico,ico-azul" scaleX="0.833" scaleY="0.833" content="M3.5 12a8.5 8.5 0 1 0 17 0a8.5 8.5 0 1 0 -17 0 M12 7.5V12l3 2"/></Group></StackPane>
            <VBox spacing="2">
                <Label text="Por aprobar" styleClass="gris"/>
                <Label fx:id="lblPorAprobar" styleClass="valor"/>
            </VBox>
        </HBox>
        <HBox styleClass="kpi" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <StackPane styleClass="icono-kpi"><Group><SVGPath styleClass="ico,ico-azul" scaleX="0.833" scaleY="0.833" content="M12 4 2.5 20h19z M12 10v4.5M12 17.2v.1"/></Group></StackPane>
            <VBox spacing="2">
                <Label text="Bajo stock" styleClass="gris"/>
                <Label fx:id="lblBajoStock" styleClass="valor"/>
            </VBox>
        </HBox>
    </HBox>
    <!-- Pestañas: una por estado del pedido -->
    <HBox fx:id="boxPestanas" spacing="6">
        <ToggleButton fx:id="tabPorAprobar" text="Por aprobar" styleClass="chip" selected="true"/>
        <ToggleButton fx:id="tabAprobado" text="Aprobado" styleClass="chip"/>
        <ToggleButton fx:id="tabEnviado" text="Enviado" styleClass="chip"/>
        <ToggleButton fx:id="tabEntregado" text="Entregado" styleClass="chip"/>
        <ToggleButton fx:id="tabRechazado" text="Rechazado" styleClass="chip"/>
    </HBox>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPedido" text="PEDIDO" prefWidth="95" sortable="false" reorderable="false"/>
            <TableColumn fx:id="colCliente" text="CLIENTE" prefWidth="175" sortable="false" reorderable="false"/>
            <TableColumn fx:id="colProductos" text="PRODUCTOS" prefWidth="105" sortable="false" reorderable="false"/>
            <TableColumn fx:id="colComprobante" text="COMPROBANTE" prefWidth="95" sortable="false" reorderable="false"/>
            <TableColumn fx:id="colFecha" text="FECHA" prefWidth="135" sortable="false" reorderable="false"/>
            <TableColumn fx:id="colTotal" text="TOTAL" prefWidth="100" sortable="false" reorderable="false"/>
            <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="110" sortable="false" reorderable="false"/>
            <TableColumn fx:id="colAcciones" text="ACCIONES" prefWidth="120" sortable="false" reorderable="false"/>
        </columns>
        <placeholder><Label text="No hay pedidos en esta pestaña."/></placeholder>
    </TableView>
</VBox>
