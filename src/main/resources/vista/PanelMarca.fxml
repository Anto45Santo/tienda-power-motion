<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- Panel izquierdo compartido por Login y Registro (se incluye con fx:include) -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           styleClass="panel-marca" prefWidth="440" minWidth="440" maxWidth="440">
    <ImageView fitWidth="440" fitHeight="430" preserveRatio="false" StackPane.alignment="BOTTOM_CENTER">
        <Image url="@../img/banners/women_drink.jpg" requestedWidth="900" requestedHeight="760" preserveRatio="false"/>
    </ImageView>
    <Region styleClass="degradado-marca"/>
    <VBox spacing="22" StackPane.alignment="TOP_LEFT">
        <padding><Insets top="40" left="40"/></padding>
        <ImageView fitWidth="200" preserveRatio="true">
            <Image url="@../img/logo.png"/>
        </ImageView>
        <Label text="Moviendo el mundo contigo." styleClass="lema"/>
    </VBox>
</StackPane>
